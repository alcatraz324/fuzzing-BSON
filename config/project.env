# Переменные окружения для проекта фаззинг-тестирования

# Корневая директория проекта (автоопределение)
PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# Время фаззинга в секундах (по умолчанию 1 минута)
FUZZ_TIME_SECONDS="${FUZZ_TIME_SECONDS:-60}"

# Лимит памяти в мегабайтах
MEMORY_LIMIT_MB=none

# Таймаут выполнения в миллисекундах
TIMEOUT_MS="${TIMEOUT_MS:-10000}"

# Путь к установленному .NET SDK
DOTNET_ROOT="${DOTNET_ROOT:-tools/dotnet}"

# Путь к бинарным файлам инструментов
TOOLS_BIN="${TOOLS_BIN:-tools/bin}"

# Экспортируем переменные, чтобы они были доступны в дочерних процессах
export PROJECT_ROOT FUZZ_TIME_SECONDS MEMORY_LIMIT_MB TIMEOUT_MS DOTNET_ROOT TOOLS_BIN
